# Copy this file to .env (it is git-ignored) and fill it in.
# `docker compose` reads .env automatically; the demo agent reads it too.

# Shared secret between the MCP security proxy and the gateway: the proxy sends it
# in the X-Proxy-Token header. Generate one and paste it after the = sign:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# While it is empty the gateway answers 503 on /scan and the other proxy
# endpoints (fail closed), so an unconfigured gateway is never open.
MCP_PROXY_TOKEN=
